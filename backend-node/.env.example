# ─────────────────────────────────────────────────────────────────────────────
# BusAlert backend — variables de entorno
# Copia este archivo a `.env` y ajusta los valores. Las marcadas como
# OBLIGATORIA hacen que el servidor no arranque si faltan.
# ─────────────────────────────────────────────────────────────────────────────

# Entorno: development | test | production
NODE_ENV=development
# Nivel de log: debug | info | warn | error | silent
LOG_LEVEL=info

# ── Servidor ────────────────────────────────────────────────────────────────
# OBLIGATORIA. Puerto HTTP.
PORT=3000
# Interfaz de escucha (0.0.0.0 = todas; 127.0.0.1 = solo local).
HOST=0.0.0.0
# Número de proxies de confianza delante del servidor (0 si no hay proxy).
TRUST_PROXY=0
# Tamaño máximo del cuerpo JSON (formato de la librería `bytes`: 10kb, 1mb...).
BODY_LIMIT=10kb
# Orígenes web permitidos por CORS, separados por coma. Vacío = CORS desactivado
# (el reloj y la app móvil no lo necesitan).
CORS_ORIGINS=

# ── Seguridad ───────────────────────────────────────────────────────────────
# OBLIGATORIA. Claves de aplicación aceptadas en la cabecera X-API-Key,
# separadas por coma (mínimo 16 caracteres cada una). Varias claves permiten
# rotarlas sin cortar el servicio. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_KEYS=
# Ventana del límite de tasa en milisegundos y máximo de peticiones por IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ── Datos ───────────────────────────────────────────────────────────────────
# Nombre de la ciudad que se usa en las instrucciones de la IA.
CITY_NAME=San Juan de Pasto, Colombia
# OBLIGATORIA. Archivo SQLite (se crea si no existe).
DB_PATH=./data/db/busalert.sqlite
# OBLIGATORIA. Carpeta con los JSON que importa `npm run seed`.
# Datos de ejemplo (marcados como demo): ./data/sample
DATA_DIR=./data
# Segundos que la red de transporte queda en caché en memoria.
CACHE_TTL_SECONDS=300

# ── Entrada de usuario ──────────────────────────────────────────────────────
# Longitud máxima de cada texto recibido (voz o pregunta).
MAX_QUERY_LENGTH=300
# Largo mínimo de una palabra para usarla en la búsqueda de paradas.
SEARCH_MIN_TERM_LENGTH=4
# Máximo de paradas devueltas por una búsqueda.
SEARCH_MAX_RESULTS=20

# ── IA (opcional) ───────────────────────────────────────────────────────────
# Clave de Google AI Studio. Si se deja vacía, el asistente responde solo con
# el planificador (sin texto generado) y /api/ai/transport-query devuelve 503.
GEMINI_API_KEY=
# Modelos (verificados en https://ai.google.dev/gemini-api/docs/models).
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite
# Tiempo máximo por llamada a la IA (ms).
AI_TIMEOUT_MS=12000
# Temperatura del modelo (0 = determinista, 2 = máxima variación).
AI_TEMPERATURE=0.2
# Cuántas alternativas del planificador se le ofrecen a la IA para elegir.
AI_MAX_PLAN_OPTIONS=3

# ── Planificador ────────────────────────────────────────────────────────────
# Máximo de alternativas devueltas.
PLANNER_MAX_ALTERNATIVES=5
# Transbordos permitidos (0 = solo rutas directas, 1 = hasta un transbordo).
PLANNER_MAX_TRANSFERS=1
# Penalización en minutos por cada transbordo al ordenar alternativas.
PLANNER_TRANSFER_PENALTY_MIN=8
# Minutos estimados por parada si no hay coordenadas para calcular distancia.
PLANNER_MINUTES_PER_STOP=1.5
# Distancia máxima (m) para caminar entre paradas en un transbordo (requiere coordenadas).
PLANNER_TRANSFER_WALK_RADIUS_M=150
# true = si hay una ruta directa se recomienda primero, aunque una con transbordo
# parezca más rápida (con paradas sin coordenadas la estimación es aproximada).
PLANNER_PREFER_DIRECT=true

# ── Estimación de tiempos (no es tiempo real) ───────────────────────────────
# Velocidad comercial media del bus en km/h.
ETA_AVERAGE_BUS_SPEED_KMH=18
# Espera media en minutos cuando la ruta no tiene frecuencia verificada
# (0 = no sumar espera).
ETA_DEFAULT_HEADWAY_MIN=0
# Velocidad al caminar en km/h (transbordos a pie).
ETA_WALK_SPEED_KMH=4.5
# Zona horaria del sistema de transporte (define el tipo de día y el horario de servicio).
TRANSIT_TIMEZONE=America/Bogota

# ── Paradas cercanas ────────────────────────────────────────────────────────
# Radio por defecto y máximo (m) de GET /api/stops/nearby y del origen por GPS.
NEARBY_DEFAULT_RADIUS_M=500
NEARBY_MAX_RADIUS_M=3000
NEARBY_MAX_RESULTS=10
